{
  "name": "aion-theme",
  "displayName": "Aion Theme",
  "description": "Dark and light themes with a measured contrast floor. Familiar syntax, distinct chrome.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "publisher": "sltsh",
  "license": "MIT",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#11151c",
    "theme": "dark"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark theme",
    "light theme",
    "color theme",
    "contrast",
    "accessibility"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sltsh/aion.git"
  },
  "bugs": {
    "url": "https://github.com/sltsh/aion/issues"
  },
  "homepage": "https://github.com/sltsh/aion#readme",
  "contributes": {
    "themes": [
      {
        "label": "Aion",
        "uiTheme": "vs-dark",
        "path": "./themes/aion.json"
      },
      {
        "label": "Aion Light",
        "uiTheme": "vs",
        "path": "./themes/aion-light.json"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/build.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@sltsh/aion-tokens": "*"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "ovsx": "^1.1.1"
  }
}
