{
  "name": "@sltsh/aion-css",
  "version": "1.0.1",
  "description": "Aion as CSS custom properties and a Tailwind v4 @theme block.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/variables.d.ts",
      "default": "./dist/variables.js"
    },
    "./aion.css": "./css/aion.css",
    "./aion.theme.css": "./css/aion.theme.css"
  },
  "files": [
    "css",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/build.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@sltsh/aion-tokens": "1.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sltsh/aion.git",
    "directory": "packages/css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
